# ---------------------------------------------------------------------------
# DecisionLens AI - backend environment
#
# Copy to `.env` in this directory and fill in real values:
#     cp .env.example .env
#
# The backend loads `backend/.env` automatically at import time (see the
# load_dotenv call at the top of server.py). Never commit the real `.env`.
# ---------------------------------------------------------------------------


# --- Required: database -----------------------------------------------------
# MongoDB connection string. The project uses MongoDB, not PostgreSQL.
# Local:   mongodb://localhost:27017
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_URL=mongodb://localhost:27017

# Database name inside the MongoDB instance.
DB_NAME=decisionlens


# --- Required: auth ---------------------------------------------------------
# Signing key for JWT access/refresh tokens. Generate a strong random value:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# Use a different value in production than in development.
JWT_SECRET=change-me-to-a-long-random-string


# --- Required: AI -----------------------------------------------------------
# Google Gemini API key, called directly over the REST API (no SDK needed).
# Get one at https://aistudio.google.com/apikey
# If this is empty, POST /api/chat returns 503 with code `llm_not_configured`
# instead of a fabricated answer. Everything else in the app still works.
GEMINI_API_KEY=

# Optional model override. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Optional: how many stored chat messages to replay as context on each turn.
# Set to 0 to send only the latest message.
CHAT_HISTORY_TURNS=20

# Optional: per-request timeout, in seconds, for the Gemini call.
GEMINI_TIMEOUT_S=60

# Optional: how many attempts one chat message may use. A client that resends the
# same request_id after a failure continues the same stored message instead of
# creating a second one; this caps how many times that may happen. Once the budget
# is spent the server answers 409 `retry_exhausted` and the user must send a new
# message. Note that a failed attempt still counts toward the monthly chat quota.
MAX_CHAT_ATTEMPTS=3

# Optional: how long, in seconds, a message may sit in "processing" before a repeat
# submission treats its worker as dead and re-dispatches it. This is a heuristic,
# not proof -- a paused-but-alive worker looks identical -- so it must stay well
# above GEMINI_TIMEOUT_S, and the server refuses to start if it does not. A crash
# between Gemini replying and the reply being acknowledged can therefore cause one
# duplicate upstream call; it can never create a duplicate message or a second
# quota charge.
CHAT_ATTEMPT_LEASE_SECONDS=180


# --- Environment / cookie behavior -----------------------------------------
# Controls the auth cookies. In development they are issued WITHOUT `Secure`
# and with SameSite=Lax, so login works over plain http://localhost. In
# production they are issued WITH `Secure` and SameSite=None for cross-site use.
#
# ENVIRONMENT: development | local | production
ENVIRONMENT=development

# Optional explicit override of the `Secure` cookie flag. Leave empty to derive
# it from ENVIRONMENT. Accepted truthy values: 1, true, yes, on.
COOKIE_SECURE=

# Optional explicit SameSite value (lax | strict | none). Leave empty to derive
# it from COOKIE_SECURE. Note: browsers reject SameSite=None without Secure.
COOKIE_SAMESITE=


# --- Seeded accounts --------------------------------------------------------
# On startup the backend creates an admin and a demo account, but ONLY if the
# matching password is set here. There are no built-in default passwords: an
# unset password means that account is skipped, not created with a guessable one.
#
# Passwords must be at least 12 characters.
ADMIN_EMAIL=admin@decisionlens.ai
ADMIN_PASSWORD=

DEMO_EMAIL=demo@decisionlens.ai
DEMO_PASSWORD=


# --- Optional: uploads ------------------------------------------------------
# Where uploaded attachments are written. Defaults to `<repo>/uploads`.
UPLOAD_DIR=


# --- Optional: frontend origin ----------------------------------------------
# Used for OAuth redirect targets after a provider callback.
FRONTEND_URL=http://localhost:3000


# --- Optional: OAuth integrations ------------------------------------------
# Salesforce. Create a Connected App and set the callback URL to:
#   <backend>/api/oauth/salesforce/callback
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=http://localhost:8000/api/oauth/salesforce/callback

# HubSpot. Create a Public App and set the redirect URL to:
#   <backend>/api/oauth/hubspot/callback
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:8000/api/oauth/hubspot/callback


# --- Optional: Stripe billing ----------------------------------------------
# Without a key the pricing page still loads, but checkout is reported as not
# configured rather than silently succeeding.
STRIPE_API_KEY=

# REQUIRED for the webhook to accept anything. Signing secret from `stripe listen`
# in development, or from the endpoint's page in the Stripe dashboard. Webhook
# payloads are rejected with a 400 if the signature does not verify, and rejected
# with a 503 if this is unset -- an unverified webhook would let anyone grant
# themselves a paid tier.
STRIPE_WEBHOOK_SECRET=

# Optional: pin the checkout redirect origin instead of trusting origin_url from
# the client. Strongly recommended in production so a caller cannot steer users
# to an attacker-controlled success page.
STRIPE_SUCCESS_URL=


# --- Test-only: database identity probe --------------------------------------
# Enables POST /api/__test/db-identity, which lets the integration suite confirm
# the running server reads the same Mongo database the suite is about to empty.
# It stays hidden from OpenAPI and is never part of the product surface.
#
# Leave BOTH of these unset in any environment that can reach real data. The
# endpoint also requires DB_NAME to be exactly "decisionlens_test", so a
# development or production database disables it even if the flag is on.
#
# TEST_DB_PROBE_SECRET must be at least 32 characters or the endpoint answers
# 404 for everything. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep it out of Git: .env is ignored, .env.example is not. The server and the
# pytest process must be given the same value.
ENABLE_TEST_DB_PROBE=
TEST_DB_PROBE_SECRET=
