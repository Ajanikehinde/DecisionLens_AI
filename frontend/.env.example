# ---------------------------------------------------------------------------
# DecisionLens AI - frontend environment
#
# Copy to `.env` in this directory:
#     cp .env.example .env
#
# Only variables prefixed with REACT_APP_ are exposed to the browser bundle.
# Anything else is server-side only and will NOT be readable in the client.
# ---------------------------------------------------------------------------


# Base URL of the FastAPI backend, with no trailing slash.
# Leave empty to use the current origin (useful behind a reverse proxy).
REACT_APP_BACKEND_URL=http://localhost:8000


# Set to "true" to expose the webpack dev-server health endpoints.
ENABLE_HEALTH_CHECK=false


# --- Optional: sign-in page hint --------------------------------------------
# Shown only when true: displays the seeded account emails on the login screen.
# Never put passwords here, they are not exposed to the browser anyway.
REACT_APP_SHOW_DEMO_HINT=false
REACT_APP_DEMO_EMAIL=demo@decisionlens.ai
REACT_APP_ADMIN_EMAIL=admin@decisionlens.ai
